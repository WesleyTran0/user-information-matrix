{
  "name": "user-information-matrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resolver user-group / role / object-type permission matrix",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc -b tsconfig.json",
    "check": "npm run typecheck && npm run check:data && npm run check:render && npm run check:live-path",
    "check:data": "node scripts/smoke.ts",
    "check:render": "vite build --config vite.render-check.config.ts && node node_modules/.tmp/render/render-check.js",
    "check:live-path": "node scripts/live-path-check.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
