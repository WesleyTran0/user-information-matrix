{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Scripts straddle both sides: they import server code (node globals) and
    // render client components (DOM + JSX).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo"
  },
  // A composite project must list every file it pulls in, so the src trees the
  // scripts import from are included here too.
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "vite.render-check.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
