# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Data source: "mock" serves bundled fixtures, "live" calls the Resolver API.
DATA_SOURCE=mock

# Base URL the endpoints in CLAUDE.md are appended to.
# e.g. https://sandbox.resolver.com/api  ->  https://sandbox.resolver.com/api/user/group
RESOLVER_BASE_URL=

# Sent as the x-api-key header.
RESOLVER_API_KEY=

# Port for the API/server process. 0 = let the OS pick a free one.
PORT=8787

# Upstream tuning.
RESOLVER_TIMEOUT_MS=30000
RESOLVER_MAX_CONCURRENCY=6
CACHE_TTL_MS=300000
